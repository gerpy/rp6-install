shaders = "10"

# *** CRT-BEAM-SHADOW1X by Tokumeino
# *** For consoles such as SNES or MD
# *** Takes 1x resolution from the core
# *** Designed for an OLED 1080p/120Hz screen (beam simulation)

# --- [ TECHNICAL STRUCTURE FROM RETROARCH SLANGP FILES ] ---
shader0 = "shaders_slang/subframe-bfi/shaders/crt-beam-simulator.slang"
filter_linear0 = "false"
scale_type0 = "source"

shader1 = "shaders_slang/crt/shaders/guest/fast/stock.slang"
filter_linear1 = "false"
scale_type1 = "source"

shader2 = "shaders_slang/crt/shaders/guest/fast/stock.slang"
alias2 = "StockPass"
filter_linear2 = "false"

shader3 = "shaders_slang/crt/shaders/guest/fast/pre-shaders.slang"
alias3 = "PrePass"
filter_linear3 = "true"

shader4 = "shaders_slang/crt/shaders/guest/fast/linearize.slang"
alias4 = "LinearizePass"
filter_linear4 = "true"
float_framebuffer4 = "true"

shader5 = "shaders_slang/crt/shaders/guest/fast/crt-guest-advanced-pass1.slang"
alias5 = "Pass1"
filter_linear5 = "true"
scale_type_x5 = "viewport"
scale_type_y5 = "source"
float_framebuffer5 = "true"

shader6 = "shaders_slang/crt/shaders/guest/fast/bloom_horizontal.slang"
filter_linear6 = "true"
scale_type_x6 = "absolute"
scale_x6 = "640.0"
scale_type_y6 = "source"
float_framebuffer6 = "true"

shader7 = "shaders_slang/crt/shaders/guest/fast/bloom_vertical.slang"
alias7 = "BloomPass"
filter_linear7 = "true"
scale_type_x7 = "source"
scale_type_y7 = "absolute"
scale_y7 = "480.0"
float_framebuffer7 = "true"

shader8 = "shaders_slang/crt/shaders/guest/fast/crt-guest-advanced-pass2.slang"
filter_linear8 = "true"
float_framebuffer8 = "true"
scale_type8 = "viewport"

shader9 = "shaders_slang/crt/shaders/guest/fast/deconvergence-f.slang"
filter_linear9 = "true"
scale_type9 = "viewport"

# --- [ TEXTURES ] ---
textures = "SamplerLUT1;SamplerLUT2;SamplerLUT3;SamplerLUT4"
SamplerLUT1 = "shaders_slang/crt/shaders/guest/advanced/lut/trinitron-lut.png"
SamplerLUT1_linear = "true"
SamplerLUT2 = "shaders_slang/crt/shaders/guest/advanced/lut/inv-trinitron-lut.png"
SamplerLUT2_linear = "true"
SamplerLUT3 = "shaders_slang/crt/shaders/guest/advanced/lut/nec-lut.png"
SamplerLUT3_linear = "true"
SamplerLUT4 = "shaders_slang/crt/shaders/guest/advanced/lut/ntsc-lut.png"
SamplerLUT4_linear = "true"

# --- [ BEAM SIMULATOR PARAMETERS ] ---
beam_sim_bvc = "0.750000"
beam_sim_gamma = "2.400000"
beam_sim_anti_retention = "0.000000"
beam_sim_pos_mod = "0.000000"
beam_sim_direction = "1.000000"

# --- [ CRT GUEST FAST PARAMETERS ] ---
contr = "0.050000"
sega_fix = "1.000000"
gamma_out = "2.200000"
inter = "400.000000"
interm = "0.000000"
h_sharp = "4.000000"
s_sharp = "1.200000"
brightboost = "1.500000"
beam_min = "2.300000"
beam_max = "1.400000"
beam_size = "0.850000"
scan_falloff = "0.600000"
shadowMask = "6.000000"
maskstr = "0.600000"
maskboost = "1.400000"
mshift = "1.000000"
mask_layout = "1.000000"
maskDark = "0.900000"
maskLight = "1.600000"
smoothmask = "1.000000"
post_br = "1.600000"