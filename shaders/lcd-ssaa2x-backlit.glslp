# *** LCD-SSAA2X-BACKLIT by Tokumeino
# *** For consoles such as PSP 
# *** Downsamples 0.5x (bicubic) from the core
# *** The core must be set to 2x upscale

# --- [ TECHNICAL STRUCTURE ] ---

shaders = "3"

# Downsampling 2x -> 1x
feedback_pass = "0"
shader0 = "shaders_glsl/cubic/shaders/bicubic.glsl"
alias0 = ""
filter_linear0 = "true"
scale_type_x0 = "source"
scale_x0 = "0.5"
scale_type_y0 = "source"
scale_y0 = "0.5"

# Response time
shader1 = "shaders_glsl/motionblur/shaders/response-time.glsl"
filter_linear1 = "false"
scale_type1 = "source"
scale1 = "1.000000"

# Rendu Simpletex
shader2 = "shaders_glsl/handheld/shaders/simpletex_lcd/simpletex_lcd.glsl"
alias2 = ""
wrap_mode2 = "clamp_to_border"
mipmap_input2 = "false"
filter_linear2 = "true"
float_framebuffer2 = "false"
srgb_framebuffer2 = "false"
scale_type_x2 = "viewport"
scale_x2 = "1.000000"
scale_type_y2 = "viewport"
scale_y2 = "1.000000"

# --- [ TEXTURES ] ---

textures = "BACKGROUND"
BACKGROUND = "shaders_glsl/handheld/shaders/simpletex_lcd/png/2k/textured_paper.png"
BACKGROUND_mipmap = "false"
BACKGROUND_wrap_mode = "clamp_to_border"

# --- [ PARAMETERS ] ---

# Bicubic downscaling
B = "0.500000"
C = "0.250000"

# Response Time
response_time = "0.444000"

# Simpletex
GRID_INTENSITY = "0.400000"
GRID_WIDTH = "0.200000"
GRID_BIAS = "0.600000"
DARKEN_GRID = "0.800000"
DARKEN_COLOUR = "0.050000"
BACKGROUND_INTENSITY = "0.000000"
