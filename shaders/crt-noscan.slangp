#reference "crt-shadow1x.slangp"

# *** CRT-NOSCAN by Tokumeino
# *** For consoles such as Dreamcast
# *** Displays high resolution from the core
# *** Designed for an OLED 1080p/60Hz screen

brightboost = "1.000000"
brightboost1 = "1.000000"
no_scanlines = "1.000000"
maskboost = "1.200000"
post_br = "1.250000"
inter = "600.000000" 
